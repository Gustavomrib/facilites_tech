# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=3000

# Postgres connection string used by Prisma.
# Local docker-compose default: postgresql://mnb:mnb@localhost:5432/meu_negocio_no_bolso?schema=public
DATABASE_URL=postgresql://mnb:mnb@localhost:5432/meu_negocio_no_bolso?schema=public

# Used by docker-compose to provision the postgres container.
POSTGRES_USER=mnb
POSTGRES_PASSWORD=mnb
POSTGRES_DB=meu_negocio_no_bolso

# Generate strong random values, e.g.: openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Signs the httpOnly refresh-token cookie. Generate with: openssl rand -hex 32
COOKIE_SECRET=change-me-too

# Comma-separated allowlist — must exactly match the frontend origin(s) (scheme +
# host + port) for cookies/CORS to work. Vite falls back to 5174+ if 5173 is
# already taken, so both are allowed by default in dev.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Only used by prisma/seed.ts. The script refuses to run when NODE_ENV=production
# unless SEED_ALLOW_PRODUCTION=true is also set — these fallback credentials are
# public (they're in this file), never let them get created on a real database.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=ChangeMe123!
# SEED_ALLOW_PRODUCTION=true
